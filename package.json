    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
