{
  "name": "aeroforge-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AeroForge AI \u2014 AI-native aerospace design & simulation platform (NL \u2192 CAD \u2192 CFD \u2192 validated design)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude \"**/*.golden.test.ts\"",
    "test:watch": "vitest",
    "test:physics": "vitest run src/lib src/data",
    "test:golden": "vitest run src/lib/wedge.golden.test.ts",
    "test:all": "vitest run",
    "test:inlet": "vitest run src/lib/inlet.golden.test.ts",
    "policy:check": "python3 oracle/opa_eval.py --out policy/rego_results.json",
    "k8s:check": "python3 oracle/validate_k8s.py deploy/k8s/*.yaml",
    "sign:check": "npx tsx scripts/sign-bundle.ts && python3 oracle/verify_signature.py signed_bundle.zip signed_bundle.sig.json"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.1",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
